{
  "model": {
    "provider": "claudecode",
    "model": "claude-opus-5-5",
    "effort": "high",
    "endpoint": "claude.exe"
  },
  "scripts": [
    "./run-tests.sh"
  ],
  "bestOfN": 3,
  "sandbox": {
    "programs": {
      "sbt": {
        "mounts": [
          {
            "path": "/opt/sbt"
          },
          {
            "path": "~/.sbt",
            "write": true
          },
          {
            "path": "~/.ivy2",
            "write": true
          },
          {
            "path": "~/.cache/coursier",
            "write": true
          }
        ]
      }
    }
  }
}
