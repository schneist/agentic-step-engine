              "until": {
                "type": "LastExitCode",
                "code": 0
              },
              "max": 2,
              "origin": "Human"
            },
            {
              "type": "Shell",
              "cmd": "aws",
              "args": [
                "ec2",
                "wait",
                "instance-running",
                "--filters",
                "Name=tag:Name,Values=rechnung-prod",
                "--region",
                "eu-central-1"
              ],
              "origin": "Human"
            },
            {
              "type": "WriteFile",
              "path": "START.md",
              "content": "# Start\n\n- Instanz: i-0a000000000000001\n- Zone: eu-central-1c\n- Spotpreis dort: 0.3921 USD/h\n- Kostendeckel: 282682 s (37 USD bei 0.4712 USD/h, höchster Zonenpreis)\n",
              "origin": "Human"
            }
          ],
          "origin": "Human"
        },
        "origin": "Human"
