                  "MarketType=spot,SpotOptions={SpotInstanceType=persistent,InstanceInterruptionBehavior=stop}",
                  "--metadata-options",
                  "HttpTokens=required,HttpEndpoint=enabled",
                  "--tag-specifications",
                  "ResourceType=instance,Tags=[{Key=Name,Value=rechnung-prod}]",
