        "thenT": {
          "type": "Ask",
          "question": "Es gibt schon eine Maschine rechnung-prod; wie weiter?",
          "origin": "Human"
        },
        "elseT": {
          "type": "Seq",
          "steps": [
            {
              "type": "RepeatUntil",
              "body": {
                "type": "Shell",
                "cmd": "aws",
                "args": [
                  "ec2",
                  "run-instances",
                  "--image-id",
                  "resolve:ssm:/aws/service/debian/release/12/latest/amd64",
                  "--instance-type",
                  "c7a.4xlarge",
                  "--placement",
                  "AvailabilityZone=eu-central-1c",
                  "--iam-instance-profile",
