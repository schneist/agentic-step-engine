    "steps": [
      {
        "type": "Shell",
        "cmd": "aws",
        "args": [
          "sts",
          "get-caller-identity",
          "--output",
          "text",
          "--region",
          "eu-central-1"
        ],
        "origin": "Human"
      },
      {
        "type": "Shell",
        "cmd": "aws",
        "args": [
          "s3api",
          "head-bucket",
          "--bucket",
          "rechnung-123456789012",
          "--region",
          "eu-central-1"
        ],
        "origin": "Human"
      },
      {
        "type": "If",
        "pred": {
          "type": "LastExitCode",
          "code": 0
        },
        "thenT": {
          "type": "Seq",
          "steps": [],
          "origin": "Human"
        },
        "elseT": {
          "type": "Shell",
          "cmd": "aws",
          "args": [
            "s3api",
            "create-bucket",
            "--bucket",
            "rechnung-123456789012",
            "--create-bucket-configuration",
            "LocationConstraint=eu-central-1",
            "--region",
            "eu-central-1"
          ],
          "origin": "Human"
        },
        "origin": "Human"
      },
      {
        "type": "Shell",
        "cmd": "aws",
        "args": [
          "s3api",
          "put-public-access-block",
          "--bucket",
          "rechnung-123456789012",
          "--public-access-block-configuration",
          "BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true",
          "--region",
          "eu-central-1"
        ],
        "origin": "Human"
      },
      {
        "type": "Shell",
        "cmd": "aws",
        "args": [
          "s3api",
          "put-object",
          "--bucket",
          "rechnung-123456789012",
          "--key",
          "paket/fall.txt",
          "--body",
          "paket/fall.txt",
          "--region",
          "eu-central-1"
        ],
        "origin": "Human"
      },
      {
        "type": "Shell",
        "cmd": "aws",
        "args": [
          "s3api",
          "put-object",
          "--bucket",
          "rechnung-123456789012",
          "--key",
          "paket/lauf.sh",
          "--body",
          "paket/lauf.sh",
          "--region",
          "eu-central-1"
        ],
        "origin": "Human"
      },
      {
        "type": "Shell",
        "cmd": "aws",
        "args": [
          "ec2",
          "describe-spot-price-history",
          "--instance-types",
          "c7a.4xlarge",
          "--product-descriptions",
          "Linux/UNIX",
          "--output",
          "text",
          "--region",
          "eu-central-1"
        ],
        "origin": "Human"
      },
      {
        "type": "WriteFile",
        "path": "stand/deckel_s",
        "content": "282682\n",
        "origin": "Human"
      },
      {
        "type": "Shell",
        "cmd": "aws",
        "args": [
          "s3api",
          "put-object",
          "--bucket",
          "rechnung-123456789012",
          "--key",
          "paket/deckel_s",
          "--body",
          "stand/deckel_s",
          "--region",
          "eu-central-1"
        ],
        "origin": "Human"
      },
      {
        "type": "Shell",
        "cmd": "aws",
        "args": [
          "ec2",
          "describe-instances",
          "--filters",
