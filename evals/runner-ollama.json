{
  "model": {
    "provider": "ollama",
    "model": "qwen3:8b",
    "think": false,
    "maxTokens": 8000,
    "contextTokens": 16384
  },
  "nestingLimit": 3,
  "scripts": [
    "./run-tests.sh"
  ],
  "sandbox": {
    "programs": {
      "sbt": {
        "mounts": [
          {
            "path": "/opt/sbt"
          },
          {
            "path": "~/.sbt",
            "write": true
          },
          {
            "path": "~/.ivy2",
            "write": true
          },
          {
            "path": "~/.cache/coursier",
            "write": true
          }
        ]
      }
    }
  }
}
